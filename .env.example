# PostgreSQL (Docker compose)
POSTGRES_USER=cs2_manager
POSTGRES_PASSWORD=cs2_manager_dev
POSTGRES_DB=cs2_manager
POSTGRES_PORT=5432

# Flask
FLASK_APP=run.py
FLASK_ENV=development
# Obligatoria en Docker Compose. Reemplazar por un valor aleatorio y privado.
SECRET_KEY=change-me-in-production
DEBUG=true

# Database connection (SQLAlchemy)
DATABASE_URL=postgresql://cs2_manager:cs2_manager_dev@localhost:5432/cs2_manager