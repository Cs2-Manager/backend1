# PostgreSQL (Docker compose)
POSTGRES_USER=cs2_manager
POSTGRES_PASSWORD=cs2_manager_dev
POSTGRES_DB=cs2_manager
POSTGRES_PORT=5432

# Flask
FLASK_APP=run.py
FLASK_ENV=development
# Obligatoria en Docker Compose. setup.ps1/setup.sh reemplazan este placeholder
# por 32 bytes aleatorios persistidos (64 caracteres hex). No usarlo como clave.
# No rotar una clave existente: invalida JWT y puede impedir descifrar datos.
SECRET_KEY=change-me-in-production
DEBUG=true

# Orígenes CORS para consumidores externos de la API (separados por comas).
# El frontend servido por nginx usa el mismo origen y NO necesita CORS.
# CORS_ORIGINS=http://localhost,http://127.0.0.1

# Servicio de notificaciones en tiempo real (NestJS + Socket.IO). La API
# interna /internal/ es solo servidor-a-servidor y nunca se publica por nginx.
REALTIME_ENABLED=true
REALTIME_URL=http://realtime:3000
REALTIME_TIMEOUT_SECONDS=2
# Secreto HMAC exclusivo para firmar eventos y verificaciones de identidad.
# NO reutilizar SECRET_KEY. En Docker se comparte por archivo dentro del
# volumen privado back_matchmaking_storage (ruta por defecto abajo).
# Puede definirse directamente aquí o dejar vacío para usar el archivo.
REALTIME_HMAC_SECRET=
REALTIME_HMAC_SECRET_FILE=/var/lib/cs2-matchmaking/realtime_hmac_secret
# Vigencia máxima de una petición interna firmada (segundos).
REALTIME_IDENTITY_MAX_AGE_SECONDS=300
# Outbox transaccional: la notificación y el evento se guardan en la misma
# transacción. El relay reintenta con backoff exponencial y límite de intentos.
REALTIME_OUTBOX_RELAY_ENABLED=true
REALTIME_OUTBOX_RELAY_INTERVAL_SECONDS=5
REALTIME_OUTBOX_BATCH_SIZE=20
REALTIME_OUTBOX_MAX_ATTEMPTS=8
REALTIME_OUTBOX_BACKOFF_BASE_SECONDS=2
REALTIME_OUTBOX_BACKOFF_MAX_SECONDS=300

# Integración con Steam (Fase 6). Crear la API key en
# https://steamcommunity.com/dev/apikey. La clave queda solo en el backend.
# Sin STEAM_API_KEY el login/vínculo responde "not_configured" y el resto de la
# plataforma sigue funcionando con normalidad.
STEAM_API_KEY=
# Origen exacto con el que el navegador abre la SPA (sin "/" final). Se usa en
# openid.return_to y en el redirect al frontend. En la LAN de ejemplo:
# STEAM_PUBLIC_BASE_URL=http://26.40.61.164
STEAM_PUBLIC_BASE_URL=http://localhost
# Intervalo mínimo entre sincronizaciones manuales (segundos).
STEAM_SYNC_MIN_INTERVAL_SECONDS=300
# Timeouts de las llamadas HTTP a Steam (segundos).
STEAM_API_TIMEOUT_SECONDS=10
STEAM_OPENID_TIMEOUT_SECONDS=10
# Vigencia de la solicitud OpenID y del handoff de un solo uso (segundos).
STEAM_AUTH_REQUEST_TTL_SECONDS=600
STEAM_HANDOFF_TTL_SECONDS=120

# Estadísticas de matchmaking oficial de CS2 (Fase 7). No usan la Steam Web API:
# el worker parsea las demos que el jugador autoriza y sube. STEAM_API_KEY es
# necesaria para descubrir share codes nuevos.
MATCHMAKING_ENABLED=true
# Clave de cifrado del game authentication code. Si queda vacía se deriva de
# SECRET_KEY (recomendado definir una propia y no rotarla sin revocar).
MATCHMAKING_SECRET_KEY=
MATCHMAKING_MAX_UPLOAD_MB=512
MATCHMAKING_MAX_ATTEMPTS=3
MATCHMAKING_SYNC_MIN_INTERVAL_SECONDS=300
MATCHMAKING_DISCOVERY_INTERVAL_SECONDS=3600
MATCHMAKING_DISCOVERY_MAX_CODES=50
MATCHMAKING_WORKER_POLL_SECONDS=15
MATCHMAKING_DEMO_EXPIRY_DAYS=31
MATCHMAKING_API_TIMEOUT_SECONDS=15

# FACEIT Data API v4 (Fase 9). Crear la API key en el Developer Portal de
# FACEIT (https://developers.faceit.com). La clave queda solo en el backend.
# Sin FACEIT_API_KEY la sección responde NOT_CONFIGURED y el resto de la
# plataforma sigue funcionando con normalidad.
FACEIT_ENABLED=true
FACEIT_API_KEY=
FACEIT_API_BASE_URL=https://open.faceit.com/data/v4
FACEIT_API_TIMEOUT_SECONDS=10
FACEIT_API_MAX_RETRIES=2
FACEIT_API_BACKOFF_BASE_SECONDS=0.5
FACEIT_CACHE_TTL_SECONDS=60
FACEIT_HISTORY_DAYS=30
FACEIT_HISTORY_LIMIT=100
FACEIT_HISTORY_MAX_PAGES=3
# Sincronización automática: intervalo objetivo y mínimo entre pedidos.
FACEIT_SYNC_INTERVAL_SECONDS=1800
FACEIT_SYNC_MIN_INTERVAL_SECONDS=300
FACEIT_SYNC_BATCH_SIZE=5
FACEIT_SYNC_LEASE_SECONDS=600
# Origen con el que el navegador abre la SPA (sin "/" final).
FACEIT_PUBLIC_BASE_URL=http://localhost
# FACEIT Connect (OAuth2 Authorization Code + PKCE). Si falta cualquier valor,
# la vinculación verificada queda como NOT_CONFIGURED. La Redirect URL debe
# coincidir exactamente con la registrada en el Developer Portal.
FACEIT_OAUTH_CLIENT_ID=
FACEIT_OAUTH_CLIENT_SECRET=
FACEIT_OAUTH_REDIRECT_URI=http://localhost/api/faceit/oauth/callback
FACEIT_OAUTH_AUTHORIZE_URL=https://accounts.faceit.com
FACEIT_OAUTH_TOKEN_URL=https://api.faceit.com/auth/v1/oauth/token
FACEIT_OAUTH_USERINFO_URL=https://api.faceit.com/auth/v1/resources/userinfo
FACEIT_OAUTH_SCOPES=openid profile membership
FACEIT_OAUTH_TIMEOUT_SECONDS=10
FACEIT_OAUTH_REQUEST_TTL_SECONDS=600
# Clave para cifrar el code_verifier PKCE. Si queda vacía se deriva de
# SECRET_KEY. Rotarla invalida los flujos OAuth en curso.
FACEIT_SECRET_KEY=

# Database connection (SQLAlchemy)
DATABASE_URL=postgresql://cs2_manager:cs2_manager_dev@localhost:5432/cs2_manager
